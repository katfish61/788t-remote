[Unit]
Description=788T Wi-Fi bridge (USB serial <-> browser)
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/788t-bridge/bridge.py --port 80
Restart=always
RestartSec=2
DynamicUser=yes
SupplementaryGroups=dialout
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
